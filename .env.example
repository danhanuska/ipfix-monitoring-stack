# Copy to .env (chmod 600 .env) and fill in both passwords.
# Generate each with: openssl rand -hex 24
# Compose refuses to start while a password is empty.
CLICKHOUSE_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional, demo mode only (docker compose --profile demo up -d)
# DEMO_SESSIONS_PER_SEC=5
# DEMO_IPV6_RATIO=0.15
# DEMO_INCIDENT_INTERVAL_MIN=20
